{
  "name": "feetza-the-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Feetza \u2014 stop the feet from stomping the pizza. A browser arcade roguelike.",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsc --noEmit && node scripts/prebuild/run.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild:check": "node scripts/prebuild/run.mjs --check",
    "prebuild:test": "node scripts/prebuild/test-deps.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "node scripts/sim/run.mjs",
    "golden": "node scripts/golden/run.mjs",
    "lint": "eslint src scripts tools",
    "lint:test": "node tools/eslint/effects.test.js",
    "check": "tsc --noEmit && npm run lint:test && npm run lint && npm run golden"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8"
  }
}
